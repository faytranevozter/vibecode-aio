# OpenChamber browser UI password
OPENCHAMBER_UI_PASSWORD=change-me

# 9router dashboard/JWT signing secret
JWT_SECRET=change-me-to-a-long-random-value

# 9router initial dashboard password
INITIAL_PASSWORD=change-me

# 9router API key HMAC secret
API_KEY_SECRET=change-me-to-a-long-random-value

# 9router stable machine-id salt
MACHINE_ID_SALT=change-me-to-a-long-random-value

# Optional: authenticate gh inside the container
# GH_TOKEN=github_pat_your_token

# Optional: enable Context7 MCP higher rate limits/private docs
# CONTEXT7_API_KEY=ctx7_your_api_key

# RTK OpenCode integration is initialized on startup by default.
# Set to 0 to disable automatic initialization.
# RTK_OPENCODE_INIT=0

# Optional: auto-install toolchains into $HOME on container start (idempotent).
# Comma-separated: go, rust, python, ruby, deno, bun, php.
# Aliases: golang, py, uv, rb, rbenv, cargo, rustup, composer.
# Prefer debian image. Needs network on first install; persists on home volume.
# INSTALL_TOOLCHAINS=go,rust,python,ruby,deno,bun,php
# GO_VERSION=1.26.5
# RUST_VERSION=stable
# PYTHON_VERSION=3.15
# RUBY_VERSION=4.0.6
# DENO_VERSION=2.9.4
# BUN_TOOLCHAIN_VERSION=1.3.14
# PHP_VERSION=8.5.8
